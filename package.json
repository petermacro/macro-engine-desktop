{
  "name": "macro-engine-desktop",
  "version": "15.0.4",
  "private": true,
  "description": "Macro Engine Desktop with dynamic content, Forex Factory NFP release-vintage data, local SQLite storage, and automatic application updates.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview",
    "test:ff": "node tools/test-forexfactory-nfp.cjs",
    "test:all": "npm run test:catalog && npm run test:ff && node tools/test-bundled-nfp.cjs && node tools/test-nfp-transform.cjs",
    "test:catalog": "node tools/test-catalog.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.2",
    "electron-updater": "6.6.2",
    "jspdf": "3.0.2",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sql.js": "1.13.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "electron": "^40.10.2",
    "electron-builder": "^26.0.12",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "wait-on": "8.0.3"
  },
  "build": {
    "appId": "com.macroengine.desktop",
    "productName": "Macro Engine",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "data/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "${env.GH_OWNER}",
        "repo": "${env.GH_REPO}"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Macro Engine"
    }
  }
}
